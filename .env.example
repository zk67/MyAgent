APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@localhost:5432/myagent
# Neon: direct (non -pooler) URL used for migrations. Optional locally.
DATABASE_URL_UNPOOLED=
DATABASE_SSL=false
TOKEN_ENCRYPTION_KEY=replace_with_a_base64_encoded_32_byte_key
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/callback
